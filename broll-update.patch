+def test_retime_drops_too_short_and_overlapping():
+    out = broll_overlay.retime_cuts([_cut(109.5, 2.0), _cut(110.5, 2.0)], 100.0, 30.0)
+    assert len(out) == 1                                                     # second overlaps first
